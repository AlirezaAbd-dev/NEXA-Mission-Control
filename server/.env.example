HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite://data/mission-control.db?mode=rwc
UPLOAD_DIR=./uploads
# Generate a unique value. Never use the development default in production.
JWT_SECRET=
# Only turn on for a local demo environment.
MISSION_CONTROL_DEMO=0
RUST_LOG=info
# Optional stable MFA encryption key; otherwise a private key is created beside the SQLite database.
MFA_ENCRYPTION_KEY=
